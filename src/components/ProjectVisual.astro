---
interface Props {
  type: 'rag' | 'voice' | 'commerce';
}
const { type } = Astro.props;
---

{type === 'rag' && (
  <div class="project-visual visual-rag" aria-hidden="true">
    <div class="visual-head"><span>knowledge/query</span><i></i></div>
    <div class="rag-query"><span>How did we reduce model cost?</span><b>↵</b></div>
    <div class="rag-results">
      <div><i>01</i><span><b>Prompt caching</b><small>relevance 0.97</small></span></div>
      <div><i>02</i><span><b>Token compression</b><small>relevance 0.94</small></span></div>
      <div><i>03</i><span><b>Model routing</b><small>relevance 0.91</small></span></div>
    </div>
    <div class="rag-score"><span>precision gain</span><strong>+35%</strong></div>
  </div>
)}

{type === 'voice' && (
  <div class="project-visual visual-voice" aria-hidden="true">
    <div class="voice-top"><span><i></i> Live call</span><b>08:42</b></div>
    <div class="waveform">
      {Array.from({ length: 38 }).map(() => <i></i>)}
    </div>
    <div class="voice-transcript">
      <span class="speaker">A</span><p><b>Evidence detected</b><small>“...the next step is to validate this with your team.”</small></p><strong>+12</strong>
    </div>
    <div class="voice-metrics"><span>Clarity <b>92</b></span><span>Discovery <b>88</b></span><span>Coverage <b>100%</b></span></div>
  </div>
)}

{type === 'commerce' && (
  <div class="project-visual visual-commerce" aria-hidden="true">
    <div class="store-nav"><b>verdant</b><span>shop&nbsp;&nbsp; story&nbsp;&nbsp; cart (2)</span></div>
    <div class="store-hero">
      <div><small>freshly curated</small><strong>Bring home<br />a little green.</strong><span>Explore collection →</span></div>
      <div class="plant-art"><i></i><i></i><i></i><i></i><b></b></div>
    </div>
    <div class="store-products"><i></i><i></i><i></i></div>
  </div>
)}
