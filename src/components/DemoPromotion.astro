---
const enabled = process.env.TEMPLATE_DEMO === 'true' || (process.env.TEMPLATE_DEMO !== 'false' && Astro.site?.hostname === 'latentfolio.vercel.app');
const pro = 'https://latentfolio-pro.netlify.app/template?utm_source=latentfolio-free-demo&utm_medium=website&utm_campaign=latentfolio_2026_11';
---
{enabled && <aside class="free-pro-offer" aria-label="LatentFolio editions"><div class="shell"><span><strong>LatentFolio Free</strong><small>Want dedicated case studies and the AI Systems Lab?</small></span><a href={pro}>Explore Pro · $29 ↗</a></div></aside>}
<style>
  .free-pro-offer { position: sticky; top: 82px; z-index: 99; background: var(--paper-light); border-bottom: 1px solid var(--line); }
  .free-pro-offer > div { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
  .free-pro-offer span { display: flex; gap: 14px; align-items: baseline; font-size: .8rem; }
  .free-pro-offer small { color: var(--muted); font-size: .7rem; }
  .free-pro-offer a { display: inline-flex; align-items: center; min-height: 40px; padding: 8px 16px; background: var(--ink); color: var(--paper); border-radius: 100px; white-space: nowrap; font-size: .75rem; font-weight: 700; }
  @media(max-width: 820px) { .free-pro-offer { top: 72px; } .free-pro-offer small { display: none; } }
  @media print { .free-pro-offer { display: none; } }
</style>
