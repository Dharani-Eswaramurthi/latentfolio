---
import Icon from './Icon.astro';
---

<div class="inference-demo" data-inference-demo>
  <div class="demo-chrome">
    <div class="chrome-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <span>production_agent.py</span>
    <span class="live-pill"><i></i> live</span>
  </div>

  <div class="demo-body">
    <div class="demo-prompt">
      <span class="prompt-mark"><Icon name="network" size={15} /></span>
      <p data-demo-query>Build a grounded answer from the strongest evidence.</p>
      <button type="button" data-demo-run aria-label="Run another AI workflow">
        Run <Icon name="arrow-right" size={14} />
      </button>
    </div>

    <div class="pipeline" role="group" aria-label="Animated retrieval augmented generation pipeline">
      <div class="pipeline-line"><span></span></div>
      <div class="pipeline-step is-active" data-demo-step>
        <span class="step-index">01</span>
        <strong>Retrieve</strong>
        <small>hybrid search</small>
      </div>
      <div class="pipeline-step" data-demo-step>
        <span class="step-index">02</span>
        <strong>Rerank</strong>
        <small>top evidence</small>
      </div>
      <div class="pipeline-step" data-demo-step>
        <span class="step-index">03</span>
        <strong>Reason</strong>
        <small>structured output</small>
      </div>
      <div class="pipeline-step" data-demo-step>
        <span class="step-index">04</span>
        <strong>Verify</strong>
        <small>grounding check</small>
      </div>
    </div>

    <div class="demo-output">
      <div class="output-head">
        <span>Response trace</span>
        <span class="output-ready"><Icon name="check" size={14} /> grounded</span>
      </div>
      <div class="trace-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="demo-stats">
        <span><small>precision</small><strong data-demo-precision>94.2%</strong></span>
        <span><small>latency</small><strong data-demo-latency>680ms</strong></span>
        <span><small>sources</small><strong data-demo-sources>08</strong></span>
      </div>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-demo-status></p>
  </div>

  <span class="demo-orbit orbit-one" aria-hidden="true">RAG</span>
  <span class="demo-orbit orbit-two" aria-hidden="true">agents</span>
</div>

<script>
  const setupInferenceDemo = () => {
    const demos = document.querySelectorAll<HTMLElement>('[data-inference-demo]:not([data-ready])');
    demos.forEach((demo) => {
      demo.dataset.ready = 'true';
      const button = demo.querySelector<HTMLButtonElement>('[data-demo-run]');
      const query = demo.querySelector<HTMLElement>('[data-demo-query]');
      const precision = demo.querySelector<HTMLElement>('[data-demo-precision]');
      const latency = demo.querySelector<HTMLElement>('[data-demo-latency]');
      const sources = demo.querySelector<HTMLElement>('[data-demo-sources]');
      const status = demo.querySelector<HTMLElement>('[data-demo-status]');
      const steps = [...demo.querySelectorAll<HTMLElement>('[data-demo-step]')];
      if (!button || !query || !precision || !latency || !sources) return;

      const runs = [
        { query: 'Build a grounded answer from the strongest evidence.', precision: '94.2%', latency: '680ms', sources: '08' },
        { query: 'Route this request to the best model for the job.', precision: '96.1%', latency: '420ms', sources: '05' },
        { query: 'Turn this call into clear, evidence-backed coaching.', precision: '93.8%', latency: '510ms', sources: '12' },
      ];
      let runIndex = 0;
      let timers: number[] = [];

      button.addEventListener('click', () => {
        timers.forEach(window.clearTimeout);
        timers = [];
        runIndex = (runIndex + 1) % runs.length;
        demo.classList.remove('is-complete');
        steps.forEach((step) => step.classList.remove('is-active', 'is-done'));
        button.disabled = true;
        demo.setAttribute('aria-busy', 'true');
        if (status) status.textContent = 'Running AI workflow.';

        steps.forEach((step, index) => {
          timers.push(window.setTimeout(() => {
            if (index > 0) {
              steps[index - 1].classList.remove('is-active');
              steps[index - 1].classList.add('is-done');
            }
            step.classList.add('is-active');
          }, index * 330));
        });

        timers.push(window.setTimeout(() => {
          const run = runs[runIndex];
          steps.at(-1)?.classList.remove('is-active');
          steps.at(-1)?.classList.add('is-done');
          query.textContent = run.query;
          precision.textContent = run.precision;
          latency.textContent = run.latency;
          sources.textContent = run.sources;
          demo.classList.add('is-complete');
          demo.removeAttribute('aria-busy');
          if (status) status.textContent = `Workflow complete. Precision ${run.precision}, latency ${run.latency}, using ${run.sources} sources.`;
          button.disabled = false;
        }, steps.length * 330));
      });
    });
  };
  setupInferenceDemo();
  document.addEventListener('astro:page-load', setupInferenceDemo);
</script>
