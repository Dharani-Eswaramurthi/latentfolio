---
import Icon from './Icon.astro';
import { profile, socialLinks, template } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div>
      <a class="footer-brand" href="/">{profile.shortName} <span>×</span> AI</a>
      <p>Engineering intelligence.<br />Showing the evidence.</p>
    </div>
    <div class="footer-links">
      <span class="footer-label">Find me online</span>
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label}
          <Icon name="arrow-up-right" size={15} />
        </a>
      ))}
      <a href={`mailto:${profile.email}`}>Email <Icon name="arrow-up-right" size={15} /></a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} {profile.name}</span>
    <a href={template.creatorUrl} target="_blank" rel="noreferrer">{template.name} by {template.creator}</a>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
