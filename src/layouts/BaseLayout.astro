---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import { profile, socialLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.bio,
  image = '/og-cover.png',
  imageAlt = `${profile.name}, ${profile.role} — portfolio preview`,
  type = 'website',
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const siteUrl = new URL('/', Astro.site).toString();
const personId = new URL('/#person', Astro.site).toString();
const personSchema = {
  '@type': 'Person',
  '@id': personId,
  name: profile.name,
  jobTitle: profile.role,
  description: profile.bio,
  url: siteUrl,
  image: new URL(profile.portrait, Astro.site).toString(),
  email: `mailto:${profile.email}`,
  sameAs: socialLinks.map((item) => item.href),
  knowsAbout: ['Generative AI', 'Retrieval-augmented generation', 'Agentic AI', 'Machine learning systems', 'MLOps', 'AI product engineering'],
  homeLocation: {
    '@type': 'Place',
    name: profile.location,
  },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).toString(),
  name: `${profile.name} — Portfolio`,
  url: siteUrl,
  description: profile.bio,
  inLanguage: 'en',
  author: { '@id': personId },
};
const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': new URL('/#profile-page', Astro.site).toString(),
  name: title,
  description,
  url: siteUrl,
  mainEntity: personSchema,
};
const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = noindex
  ? []
  : [
      websiteSchema,
      Astro.url.pathname === '/'
        ? profilePageSchema
        : { '@context': 'https://schema.org', ...personSchema },
      ...pageSchema,
    ];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('has-js');
      try {
        const savedTheme = localStorage.getItem('latentfolio-theme');
        const systemTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : systemTheme;
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f5f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111016" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/pdf" href={profile.resume} title={`${profile.name} resume`} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${profile.name} — Portfolio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-noise" aria-hidden="true"></div>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="cursor-glow" aria-hidden="true" data-cursor-glow></div>

    <script>
      const setupGlobalEffects = () => {
        const glow = document.querySelector<HTMLElement>('[data-cursor-glow]');
        if (glow && !glow.dataset.ready && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          glow.dataset.ready = 'true';
          window.addEventListener('pointermove', (event) => {
            glow.style.setProperty('--pointer-x', `${event.clientX}px`);
            glow.style.setProperty('--pointer-y', `${event.clientY}px`);
          }, { passive: true });
        }

        const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-reveal-ready])');
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              (entry.target as HTMLElement).classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px' });
          reveals.forEach((item) => {
            item.dataset.revealReady = 'true';
            observer.observe(item);
          });
        } else {
          reveals.forEach((item) => item.classList.add('is-visible'));
        }
      };
      setupGlobalEffects();
      document.addEventListener('astro:page-load', setupGlobalEffects);
    </script>
  </body>
</html>
